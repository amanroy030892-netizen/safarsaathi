{
  "name": "SafarSaathi: Carpooling Assam",
  "short_name": "SafarSaathi",
  "description": "Verified peer-to-peer E-Rickshaw radar and intercity carpooling network across Assam and North-East India.",
  "id": "/index.html",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0f172a",
  "theme_color": "#15803d",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": [
    "travel",
    "navigation",
    "transportation"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-narrow-540x960.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "SafarSaathi Live E-Rickshaw Radar and Carpool Booking"
    },
    {
      "src": "feature-graphic-1024x500.png",
      "sizes": "1024x500",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SafarSaathi GPS Route Map and Carpool Network across Assam"
    }
  ],
  "shortcuts": [
    {
      "name": "Find Rides",
      "short_name": "Find",
      "description": "Search available carpool rides in Assam",
      "url": "/index.html?tab=passenger",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live E-Rickshaw",
      "short_name": "E-Rickshaw",
      "description": "View live E-Rickshaw radar on map",
      "url": "/index.html?tab=live-erickshaw",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Profile & KYC",
      "short_name": "Profile",
      "description": "Manage your profile, identity and bookings",
      "url": "/index.html?tab=profile",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}